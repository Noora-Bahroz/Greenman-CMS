# Copy this file to:  deploy/.env.production
# then fill in every empty value. NEVER commit .env.production.
# It is loaded by docker-compose via `env_file` on the CMS service.

# ---------- REQUIRED ----------
# Long random string (>=32 chars). Generate with:  openssl rand -base64 32
PAYLOAD_SECRET=

# Production domain for the CMS (must resolve to this server).
# Same value is used by Caddy for automatic HTTPS.
PAYLOAD_PUBLIC_SERVER_URL=https://your-cms-domain.example.com

# ---------- Usually leave these as-is (docker-compose overrides them) ----------
DATABASE_URI=file:/app/data/payload.db
P5_DB_URI=file:/app/data/payload.db
GREENMAN_DATA_DIR=/app/frontend/data
GREENMAN_WEB_DIR=/app/frontend

# ---------- OWNER-ONLY: set CMS_DOMAIN for Compose/Caddy ----------
# docker-compose interpolates ${CMS_DOMAIN} from the shell environment or
# from a `deploy/.env` file (compose substitution file, NOT this one).
# Example:  set CMS_DOMAIN=admin.greenman.com
# In deploy/.env:  CMS_DOMAIN=admin.greenman.com